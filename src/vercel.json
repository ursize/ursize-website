{
  "version": 2,
  "buildCommand": "npm install && node build.js",
  "outputDirectory": ".",
  "functions": {
    "api/*.js": { "runtime": "nodejs20.x" }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "env": {
    "SITE_DOMAIN": "@site-domain",
    "IP_SALT": "@ip-salt"
  }
}
